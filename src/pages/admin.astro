---
import Base from '../layouts/Base.astro';
import { ruta } from '../lib/rutas';
---
<Base title="Respuestas · Compartir navideño" wide>
  <div class="userbar">
    <span>Sesión: <strong id="userEmail">...</strong></span>
    <span class="links">
      <a href={ruta('/registro')}>Mi registro</a>
      <button type="button" class="btn link" id="logoutBtn">Salir</button>
    </span>
  </div>
  <header class="top">
    <span class="eyebrow">Sábado 5 de diciembre · Organización</span>
    <h1>Respuestas recibidas</h1>
    <p class="lead">Resumen de adultos y niños, y el detalle de cada familia.</p>
    <div class="garland"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
  </header>

  <div class="loading" id="loading">Cargando respuestas...</div>
  <div class="status err" id="denied" hidden>Esta página es solo para organizadores. Si eres organizador, pide que te asignen el rol <code>admin</code> en Clerk.</div>

  <div id="panel" hidden>
    <nav class="tabs" role="tablist" aria-label="Secciones del panel">
      <button type="button" role="tab" id="tabRespuestas" aria-selected="true" aria-controls="vistaRespuestas" data-vista="respuestas">Respuestas</button>
      <button type="button" role="tab" id="tabUso" aria-selected="false" aria-controls="vistaUso" data-vista="uso">Uso del sitio</button>
    </nav>

    <div id="vistaRespuestas" role="tabpanel" aria-labelledby="tabRespuestas">
    <section>
      <h2>Resumen</h2>
      <p class="hint">Los totales cuentan solo a las familias que no respondieron "No podremos".</p>
      <div class="stats">
        <article class="stat">
          <h3>Adultos</h3>
          <div class="big" id="stAdultos">0</div>
          <dl id="dlAdultos"></dl>
        </article>
        <article class="stat">
          <h3>Niños</h3>
          <div class="big" id="stNinos">0</div>
          <dl id="dlNinos"></dl>
        </article>
        <article class="stat">
          <h3>Familias</h3>
          <div class="big" id="stFamilias">0</div>
          <dl id="dlFamilias"></dl>
        </article>
        <article class="stat">
          <h3>Pueden ayudar con</h3>
          <dl id="dlAyuda"></dl>
        </article>
      </div>
    </section>

    <section>
      <h2>Familias</h2>
      <p class="hint">Responsable del registro, acompañantes adultos e hijos de cada respuesta. Edades al 5 de diciembre.</p>
      <div class="filtros">
        <div class="chips" id="filtroAsiste">
          <label><input type="radio" name="fAsiste" value="" checked />Todas</label>
          <label><input type="radio" name="fAsiste" value="Sí" />Sí, vamos</label>
          <label><input type="radio" name="fAsiste" value="Por confirmar" />Por confirmar</label>
          <label><input type="radio" name="fAsiste" value="No" />No podrán</label>
        </div>
        <input type="search" id="filtroTexto" placeholder="Buscar por nombre, niño, celular o correo" aria-label="Buscar familia" />
        <span class="cnt" id="filtroCuenta"></span>
      </div>
      <div id="familias"></div>
    </section>

    <section>
      <details>
        <summary>Lista de niños para los regalos</summary>
        <p class="hint">Un renglón por niño, ordenados por edad.</p>
        <div class="tbl-wrap"><table>
          <thead><tr><th>Niño</th><th>Edad</th><th>Sexo</th><th>Intereses</th><th>Alergias</th><th>Familia</th><th>Asiste</th></tr></thead>
          <tbody id="rowsNinos"></tbody>
        </table></div>
      </details>
    </section>

    <div class="actions">
      <button type="button" class="btn ghost" id="xlsxBtn">Exportar a Excel</button>
      <p class="hint">Un archivo .xlsx con hojas de Resumen, Familias, Acompañantes, Niños y Uso.</p>
    </div>
    </div>

    <div id="vistaUso" role="tabpanel" aria-labelledby="tabUso" hidden>
    <section>
      <h2>Uso del sitio</h2>
      <p class="hint">Cómo llegan y qué hacen las familias, sin datos personales. Cuenta personas distintas (un identificador guardado en cada navegador, unido al usuario si ingresó; quien use dos dispositivos sin ingresar cuenta dos veces); lo que hacen los organizadores en este panel no entra en los indicadores. Se actualiza en vivo.</p>
      <div class="stats uso">
        <article class="stat">
          <h3>Embudo de registro</h3>
          <div class="big" id="usoPersonas">0</div>
          <p class="hint">personas distintas</p>
          <ol class="embudo" id="usoEmbudo"></ol>
        </article>
        <article class="stat">
          <h3>Dispositivos</h3>
          <dl id="usoDispositivos"></dl>
          <h3 class="sub">Navegadores</h3>
          <dl id="usoNavegadores"></dl>
          <h3 class="sub">Origen</h3>
          <dl id="usoOrigenes"></dl>
        </article>
        <article class="stat">
          <h3>Fricción</h3>
          <dl id="usoFriccion"></dl>
          <h3 class="sub">Campos que más fallan</h3>
          <dl id="usoCampos"></dl>
        </article>
        <article class="stat">
          <h3>Música</h3>
          <dl id="usoMusica"></dl>
          <h3 class="sub">Canciones más puestas</h3>
          <dl id="usoPistas"></dl>
        </article>
      </div>
    </section>

    <section>
      <h2>Últimos eventos</h2>
      <p class="hint">Los 40 más recientes. "Quién" es el final del id de usuario o el inicio del id de sesión anónima.</p>
      <div class="tbl-wrap"><table>
        <thead><tr><th>Cuándo</th><th>Evento</th><th>Detalle</th><th>Página</th><th>Dispositivo</th><th>Quién</th></tr></thead>
        <tbody id="rowsEventos"></tbody>
      </table></div>
      <div class="status err" id="usoError" hidden></div>
    </section>
    </div>
  </div>

  <script>
    import '../scripts/admin';
  </script>
</Base>
