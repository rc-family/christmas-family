---
import Base from '../layouts/Base.astro';
---
<Base title="Respuestas · Compartir navideño" wide>
  <div class="userbar">
    <span>Sesión: <strong id="userEmail">...</strong></span>
    <span class="links">
      <a href="/registro">Mi registro</a>
      <button type="button" class="btn link" id="logoutBtn">Salir</button>
    </span>
  </div>
  <header class="top">
    <span class="eyebrow">Sábado 5 de diciembre · Organización</span>
    <h1>Respuestas recibidas</h1>
    <p class="lead">Resumen de adultos y niños, y el detalle de cada familia.</p>
    <div class="garland"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
  </header>

  <div class="loading" id="loading">Cargando respuestas...</div>
  <div class="status err" id="denied" hidden>Esta página es solo para organizadores. Si eres organizador, pide que te asignen el rol <code>admin</code> en Clerk.</div>

  <div id="panel" hidden>
    <section>
      <h2>Resumen</h2>
      <p class="hint">Los totales cuentan solo a las familias que no respondieron "No podremos".</p>
      <div class="stats">
        <article class="stat">
          <h3>Adultos</h3>
          <div class="big" id="stAdultos">0</div>
          <dl id="dlAdultos"></dl>
        </article>
        <article class="stat">
          <h3>Niños</h3>
          <div class="big" id="stNinos">0</div>
          <dl id="dlNinos"></dl>
        </article>
        <article class="stat">
          <h3>Familias</h3>
          <div class="big" id="stFamilias">0</div>
          <dl id="dlFamilias"></dl>
        </article>
        <article class="stat">
          <h3>Pueden ayudar con</h3>
          <dl id="dlAyuda"></dl>
        </article>
      </div>
    </section>

    <section>
      <h2>Familias</h2>
      <p class="hint">Padre o madre, acompañantes adultos e hijos de cada respuesta. Edades al 5 de diciembre.</p>
      <div id="familias"></div>
    </section>

    <section>
      <details>
        <summary>Lista de niños para los regalos</summary>
        <p class="hint">Un renglón por niño, ordenados por edad.</p>
        <div class="tbl-wrap"><table>
          <thead><tr><th>Niño</th><th>Edad</th><th>Sexo</th><th>Intereses</th><th>Alergias</th><th>Familia</th><th>Asiste</th></tr></thead>
          <tbody id="rowsNinos"></tbody>
        </table></div>
      </details>
    </section>

    <div class="actions">
      <button type="button" class="btn ghost" id="xlsxBtn">Exportar a Excel</button>
      <p class="hint">Un archivo .xlsx con hojas de Resumen, Familias, Acompañantes y Niños.</p>
    </div>
  </div>

  <script>
    import '../scripts/admin';
  </script>
</Base>
