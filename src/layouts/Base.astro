---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  wide?: boolean;
}
const {
  title = 'Compartir navideño de la familia',
  description = 'Registro de participantes para el compartir navideño familiar.',
  wide = false,
} = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Figtree:wght@400;500;600;700&display=swap" />
    <title>{title}</title>
  </head>
  <body>
    <div class:list={['sheet', { wide }]}>
      <slot />
    </div>
  </body>
</html>
