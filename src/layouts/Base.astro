---
import '../styles/global.css';
import Musica from '../components/Musica.astro';

interface Props {
  title?: string;
  description?: string;
  wide?: boolean;
  /** Portada a todo el ancho (sin hoja ni adornos fijos); la página trae su propia barra con el reproductor. */
  portada?: boolean;
  /** Solo portada: fondo verde nocturno con nieve (true) o crema claro (false). */
  noche?: boolean;
}
const {
  title = 'Compartir navideño de la familia',
  description = 'Registro de participantes para el compartir navideño familiar.',
  wide = false,
  portada = false,
  noche = false,
} = Astro.props;
/* Copos de nieve con posición, tamaño y tiempos deterministas (sin aleatoriedad en el build). */
const copos = Array.from({ length: 32 }, (_, i) => ({
  x: (i * 37 + 11) % 100,
  s: 0.5 + ((i * 7) % 9) / 10,
  t: 11 + ((i * 13) % 11),
  d: -((i * 5) % 17),
  o: 0.45 + ((i * 3) % 5) / 10,
}));
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,600;0,9..144,700;1,9..144,600;1,9..144,700&family=Figtree:wght@400;500;600;700&display=swap" />
    <title>{title}</title>
  </head>
  <body class:list={{ portada, noche: portada && noche }}>
    {!portada && (
      <>
        <div class="marco" aria-hidden="true"></div>
        <div class="suelo" aria-hidden="true">
          <svg class="ola" viewBox="0 0 1200 70" preserveAspectRatio="none"><path d="M0 40 C150 10 250 70 400 45 S650 10 800 40 S1050 70 1200 35 V70 H0Z"/></svg>
          <svg class="arbol izq" viewBox="0 0 60 90"><path class="t" d="M30 2 L45 30 H38 L50 52 H41 L56 78 H4 L19 52 H10 L22 30 H15Z"/><rect x="26" y="78" width="8" height="10" rx="1" class="tronco"/><path class="estrella" d="M30 0 l2.2 4.6 5 .7-3.6 3.5.9 5-4.5-2.4-4.5 2.4.9-5L22.6 5.3l5-.7Z"/><circle cx="24" cy="40" r="2" class="bola"/><circle cx="38" cy="60" r="2" class="bola"/><circle cx="20" cy="68" r="2" class="bola oro"/><circle cx="36" cy="28" r="1.8" class="bola oro"/></svg>
          <svg class="arbol der" viewBox="0 0 60 90"><path class="t" d="M30 2 L45 30 H38 L50 52 H41 L56 78 H4 L19 52 H10 L22 30 H15Z"/><rect x="26" y="78" width="8" height="10" rx="1" class="tronco"/><path class="estrella" d="M30 0 l2.2 4.6 5 .7-3.6 3.5.9 5-4.5-2.4-4.5 2.4.9-5L22.6 5.3l5-.7Z"/><circle cx="36" cy="40" r="2" class="bola"/><circle cx="22" cy="60" r="2" class="bola"/><circle cx="40" cy="68" r="2" class="bola oro"/><circle cx="24" cy="28" r="1.8" class="bola oro"/></svg>
        </div>
        <div class:list={['topbar', { wide }]}>
          <Musica />
        </div>
      </>
    )}
    {(!portada || noche) && (
      <div class="nieve" aria-hidden="true">
        {copos.map((c) => <i style={`--x:${c.x}%;--s:${c.s};--t:${c.t}s;--d:${c.d}s;--o:${c.o}`}></i>)}
      </div>
    )}
    {portada ? <slot /> : <div class:list={['sheet', { wide }]}><slot /></div>}
    <script>
      import '../scripts/musica';
    </script>
  </body>
</html>
