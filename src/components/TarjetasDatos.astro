---
/** Las tres tarjetas del compartir: Cuándo, Dónde y Plazo. Se usan en la portada y en la ventana de detalles. */
import { DATOS_COMPARTIR } from '../lib/edad';
interface Props { modal?: boolean }
const { modal = false } = Astro.props;
---
<ul class:list={['tarjetas-datos', { 'en-modal': modal }]}>
  <li>
    <span class="ico verde" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="3.5" y="5" width="17" height="15" rx="2.5" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M3.5 10h17M8 3v4M16 3v4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><rect x="7" y="13" width="4" height="3" rx=".6" fill="currentColor"/></svg></span>
    <div><small>Cuándo</small><strong>{DATOS_COMPARTIR.fecha}</strong><span>{DATOS_COMPARTIR.hora}</span></div>
  </li>
  <li>
    <span class="ico claro" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 21s-6.5-6-6.5-11a6.5 6.5 0 0 1 13 0c0 5-6.5 11-6.5 11Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><circle cx="12" cy="10" r="2.3" fill="none" stroke="currentColor" stroke-width="1.8"/></svg></span>
    <div><small>Dónde</small><strong>{DATOS_COMPARTIR.lugar}</strong><span>{DATOS_COMPARTIR.lugarNota}</span></div>
  </li>
  <li class="plazo">
    <span class="ico rojo" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="13" r="7.5" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M12 9v4l2.5 2M5 5 3 7M19 5l2 2" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></span>
    <div><small>Plazo</small><strong>{DATOS_COMPARTIR.limite}</strong><span>Último día para responder o cambiar tu respuesta.</span></div>
  </li>
</ul>
